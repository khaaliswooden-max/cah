# Data files (too large for git)
data/raw/**/*.csv

# CMS Cost Report data (download from source)
data/cms_cost_reports/**/*.csv
data/raw/**/*.zip
data/raw/**/*.xlsx
data/processed/**/*.csv
data/processed/**/*.parquet

# CMS Rural Health & CAH scrape: bulk raw downloads are reproducible via
# step6_scrape_cms_rural_health.py (sha256-pinned in manifest.json).
# Commit only the manifest + small filtered summary artifacts.
data/cms_rural_health/cah/*.csv
data/cms_rural_health/cah/*.zip
data/cms_rural_health/geography/*.csv
data/cms_rural_health/geography/*.zip
data/cms_rural_health/post_acute/*.csv
data/cms_rural_health/post_acute/*.zip
data/cms_rural_health/rural/fqhc_*.csv
data/cms_rural_health/rural/rhc_*.csv
!data/cms_rural_health/manifest.json
!data/cms_rural_health/cah_hospitals.csv
!data/cms_rural_health/rural_emergency_hospitals.csv
!data/cms_rural_health/rural/reh_*.csv

# Keep directory structure but ignore data
!data/raw/.gitkeep
!data/processed/.gitkeep

# Reports (can regenerate)
reports/acquisition/*.json

# Vercel build output: reports copied into dashboard/ at deploy time
dashboard/reports/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Virtual environment
venv/
env/
.env

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Jupyter Notebooks
.ipynb_checkpoints/

# Build artifacts
dist/
build/
*.egg-info/

